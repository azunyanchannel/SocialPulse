{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialpulse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Any Workers AI text model that supports JSON-schema `response_format`.
    // Override in the Dashboard (Settings → Variables) without a redeploy of code.
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": {
    "enabled": true
  }
}
